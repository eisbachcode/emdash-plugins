{
	"name": "@eisbachcode/emdash-plugin-analytics",
	"version": "0.1.0",
	"description": "EmDash plugin: Cloudflare Web Analytics on the dashboard and next to your content.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"cms",
		"plugin",
		"analytics",
		"cloudflare",
		"dashboard"
	],
	"license": "MIT",
	"author": "Eisbachcode <daniel@eisbachcode.de>",
	"homepage": "https://github.com/eisbachcode/emdash-plugins/tree/main/packages/analytics#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eisbachcode/emdash-plugins.git",
		"directory": "packages/analytics"
	},
	"bugs": "https://github.com/eisbachcode/emdash-plugins/issues",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./astro": {
			"import": "./dist/astro/index.mjs",
			"types": "./dist/astro/index.d.mts"
		}
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build && tsdown",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"registry:login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup",
		"prepublishOnly": "pnpm run build",
		"build:astro": "tsdown"
	},
	"engines": {
		"node": ">=22.16"
	},
	"peerDependencies": {
		"emdash": ">=0.39.0"
	},
	"devDependencies": {
		"@eisbachcode/emdash-plugin-shared": "workspace:*",
		"@emdash-cms/blocks": "0.39.0",
		"@emdash-cms/plugin-cli": "0.12.0",
		"@emdash-cms/plugin-test": "0.2.0",
		"emdash": ">=0.39.0 <1.0.0",
		"tsdown": "0.20.3",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
